# Copy this file to .env and fill in real values before deploying.

# Session cookie signing key — set this to a long random string in production.
APP_SECRET_KEY=change-this-to-a-random-secret

# SMTP settings for the /inquiry form. For Gmail:
#   1. Turn on 2-Step Verification on the Google account.
#   2. Create an "App Password" (Google Account -> Security -> App passwords).
#   3. Use that 16-character app password below (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pers1052@gmail.com
SMTP_PASSWORD=your-gmail-app-password
INQUIRY_TO_EMAIL=pers1052@gmail.com

# Persistent storage for deployment (leave empty locally to use SQLite + local uploads).
# Neon PostgreSQL connection string, e.g. postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Cloudinary API environment variable, e.g. cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
